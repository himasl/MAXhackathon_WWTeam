# Copy to .env and fill in. Never commit .env — it is in .gitignore.

APP_ENV=development
# Neon / Render style postgres://... URLs are accepted and converted automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/marshrut

# Public HTTPS address of the deployment (Mini App URL, webhook base). Empty locally.
PUBLIC_URL=
FRONTEND_URL=http://localhost:8000

# MAX bot (token is issued by the hackathon organisers).
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
MAX_BOT_USERNAME=t818_hakaton_max_bot
# link: buttons open PUBLIC_URL with a signed per-user login; open_app: registered Mini App
MAX_BUTTON_MODE=link
# off | polling (local) | webhook (production, requires PUBLIC_URL)
BOT_MODE=polling
WEBHOOK_SECRET=
REMINDERS_ENABLED=true
REMINDER_INTERVAL_SECONDS=3600

# Signs access tokens. Required in production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Reviewer tokens for the automated API check: token:max_user_id[,token2:max_user_id2]
TEST_ACCESS_TOKENS=

SCENARIO_DATA_DIR=../data/scenarios

# Development only. Ignored when APP_ENV=production.
DEV_AUTH_ENABLED=true
DEV_MAX_USER_ID=123456

# MAX user ids of the team (comma-separated): daily digest of «Сообщить о неточности» notes,
# alerts about server errors and the /stats bot command.
# The bot replies to /id with your MAX id.
SUPPORT_MAX_USER_IDS=
